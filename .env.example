# Copy to .env and fill in. .env is git-ignored and is never readable by sandboxed code.

# --- Credentials -------------------------------------------------------------
ANTHROPIC_API_KEY=            # https://platform.claude.com/settings/keys
TYPESAFE_API_KEY=             # https://console.typesafe.ai/keys

# --- Modes -------------------------------------------------------------------
# live = real API calls (measured).  scripted/mock = offline, clearly labeled simulated.
RECOVERIQ_LLM_MODE=scripted   # live | scripted
RECOVERIQ_JEV_MODE=mock       # live | mock
RECOVERIQ_JEV_MODEL=jev-latest  # or pin a version, e.g. jev-1.13.0, for reproducible thresholds

# --- Model tiers ---------------------------------------------------------------
RECOVERIQ_CHEAP_MODEL=claude-haiku-4-5
RECOVERIQ_CHEAP_MAX_TOKENS=1024     # cost guard; long files are truncated on purpose (t3 scenario)
RECOVERIQ_STRONG_MODEL=claude-opus-5
RECOVERIQ_STRONG_MAX_TOKENS=8000
RECOVERIQ_STRONG_EFFORT=medium      # low | medium | high | xhigh | max

# Imputed cost per human escalation, reported separately from API spend.
RECOVERIQ_HUMAN_COST_USD=0.50
